# ---------------------------------------------------------------------------
# Copie para .env.local. Está no .gitignore e NUNCA deve ser versionado.
# Nenhuma variável aqui usa o prefixo NEXT_PUBLIC_ — esse prefixo embute o
# valor no bundle do navegador e exporia toda credencial deste arquivo.
# ---------------------------------------------------------------------------

# API privada de cotações (Bearer Token) — https://brapi.dev
BRAPI_TOKEN=
BRAPI_BASE_URL=https://brapi.dev/api/v2

# API pública de indicadores (sem autenticação) — https://brasilapi.com.br
BRASILAPI_BASE_URL=https://brasilapi.com.br/api

# Banco no-code (Personal Access Token, escopo restrito a esta base)
# Escopos necessários: data.records:read, data.records:write, schema.bases:read
# e schema.bases:write (este último só para rodar `bun run setup:airtable`).
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_BASE_URL=https://api.airtable.com/v0
AIRTABLE_TABLE_USERS=Users
AIRTABLE_TABLE_SESSIONS=Sessions
AIRTABLE_TABLE_ASSETS=Assets
AIRTABLE_TABLE_QUOTES=Quotes
AIRTABLE_TABLE_ALERTS=Alerts

# Autenticação própria
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800

# Automação
ALERTS_WEBHOOK_URL=
CRON_SECRET=

# Cache e controle de tráfego
CACHE_TTL_QUOTES_SECONDS=300
CACHE_TTL_INDICATORS_SECONDS=86400
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=60

# Janela de pregão (horário de Brasília)
MARKET_OPEN_HOUR=10
MARKET_CLOSE_HOUR=18
